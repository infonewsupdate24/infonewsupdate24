{
  "name": "infonewsupdate24",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/generate_sitemaps.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "postbuild": "node scripts/generate_article_seo_pages.cjs && node scripts/validate_seo.cjs && node scripts/prepare_preview_runtime.cjs",
    "test:preview": "node --test scripts/article_preview.test.mjs scripts/worker_preview.test.mjs",
    "build:preview": "npm run build",
    "build:cached": "node scripts/build_cached_snapshot.cjs",
    "deploy:preview": "node scripts/prepare_preview_runtime.cjs && npx --yes wrangler@4.136.1 deploy --config wrangler.preview.jsonc",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting --project in24-news-platform-6f802 --config firebase.hosting.generated.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
