sDeskManagerView\';\nimport { GovtSchemesManagerView } from \'./components/cms/GovtSchemesManagerView\';\nimport { PanchangManagerView } from \'./components/cms/PanchangManagerView\';\nimport { GadchiroliSpotlightManagerView } from \'./components/cms/GadchiroliSpotlightManagerView\';\nimport { LiveBlogManagerView } from \'./components/cms/LiveBlogManagerView\';\nimport { NewsletterManagerView } from \'./components/cms/NewsletterManagerView\';\nimport { HomepageLayoutBuilderView } from \'./components/cms/HomepageLayoutBuilderView\';\nimport { GoogleSearchConsoleSettingsView } from \'./components/cms/GoogleSearchConsoleSettingsView\';\nimport { BillingManagerView } from \'./components/cms/BillingManagerView\';\nimport { GlobalSettingsManagerView } from \'./components/cms/GlobalSettingsManagerView\';\nimport { SecurityCenterView } from \'./components/cms/SecurityCenterView\';\nimport { PressCardManagerView } from \'./components/cms/PressCardManagerView\';\nimport { PublicPortalView } from \'./components/public/PublicPortalView\';\nimport { AppProvider, useApp } from \'./context/AppContext\';\nimport { AuthProvider, useAuth } from \'./context/AuthContext\';\n\nconst MainRouter: React.FC = () => {\n  const { portalMode, cmsView } = useApp();\n  const { currentUser, isLoggedIn } = useAuth();\n\n  // Strict Security Gate:\n  // CMS Dashboard requires an authenticated session with staff role (SUPER_ADMIN, ADMIN, EDITOR, SUB_EDITOR, REPORTER, etc.)\n  // Unauthenticated visitors, guests, and regular readers (\'USER\') are NEVER allowed into the CMS Dashboard\n  const isStaffAuthenticated =\n    isLoggedIn &&\n    currentUser &&\n    currentUser.role !== \'USER\' &&\n    (currentUser.status || \'ACTIVE\') === \'ACTIVE\';\n\n  if (portalMode === \'PUBLIC\' || !isStaffAuthenticated) {\n    return <PublicPortalView />;\n  }\n\n  // If in CMS Dashboard Mode\n  const renderCmsContent = () => {\n    switch (cmsView) {\n      case \'dashboard\':\n        return <DashboardView />;\n      case \'posts_all\':\n        return <PostsListView />;\n      case \'posts_new\':\n      case \'posts_edit\':\n        return <PostEditorView />;\n      case \'categories\':\n        return <CategoryManagerView />;\n      case \'tags\':\n        return <TagManagerView />;\n      case \'media\':\n        return <MediaLibraryView />;\n      case \'pages\':\n        return <PageManagerView />;\n      case \'social_media\':\n        return <SocialMediaManagerView />;\n      case \'users\':\n        return <UsersManagerView />;\n      case \'user_profile\':\n        return <UserProfileView />;\n      case \'breaking_ticker\':\n        return <BreakingTickerManagerView />;\n      case \'polls\':\n        return <LivePollsManagerView />;\n      case \'cricket_mandi\':\n        return <LiveCricketAndMandiManagerView />;\n      case \'ai_voice\':\n        return <AIVoiceSettingsView />;\n      case \'advertisements\':\n        return <AdvertisementManagerView />;\n      case \'merchant_ads\':\n        return <MerchantAdBookingManagerView />;\n      case \'epaper\':\n        return <EPaperManagerView />;\n      case \'web_push\':\n        return <WebPushManagerView />;\n      case \'pwa\':\n        return <PWAManagerView />;\n      case \'whatsapp_hub\':\n        return <WhatsAppChannelManagerView />;\n      case \'whatsapp_bulletin\':\n        return <WhatsAppBulletinManagerView />;\n      case \'web_stories\':\n        return <WebStoriesManagerView />;\n      case \'weather\':\n        return <LiveWeatherManagerView />;\n      case \'citizen_news\':\n        return <CitizenNewsDeskManagerView />;\n      case \'govt_schemes\':\n        return <GovtSchemesManagerView />;\n      case \'panchang\':\n        return <PanchangManagerView />;\n      case \'gadchiroli_spotlight\':\n        return <GadchiroliSpotlightManagerView />;\n      case \'live_blog\':\n        return <LiveBlogManagerView />;\n      case \'newsletter\':\n        return <NewsletterManagerView />;\n      case \'homepage_layout\':\n        return <HomepageLayoutBuilderView />;\n      case \'google_search_console\':\n        return <GoogleSearchConsoleSettingsView />;\n      case \'billing\':\n        return <BillingManagerView />;\n      case \'settings\':\n        return <GlobalSettingsManagerView />;\n      case \'security\':\n        return <SecurityCenterView />;\n      case \'press_cards\':\n        return <PressCardManagerView />;\n      default:\n        return <GenericModuleView view={cmsView} />;\n    }\n  };\n\n  return <CMSLayout>{renderCmsContent()}</CMSLayout>;\n};\n\nexport default function App() {\n  return (\n    <AuthProvider>\n      <AppProvider>\n        <MainRouter />\n      </AppProvider>\n    </AuthProvider>\n  );\n}\n\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@keyframes tickerMarquee {\n  0% {\n    transform: translate3d(0, 0, 0);\n  }\n  100% {\n    transform: translate3d(-50%, 0, 0);\n  }\n}\n\n.animate-ticker-marquee {\n  display: flex;\n  width: max-content;\n  will-change: transform;\n  animation: tickerMarquee var(--ticker-duration, 28s) linear infinite;\n}\n\n.pause-on-hover:hover .animate-ticker-marquee {\n  animation-play-state: paused !important;\n}\n\n/* InfoNewsUpdate24 Article Body Styles */\n.article-html-content p {\n  margin-bottom: 1rem;\n  line-height: 1.75;\n  color: #1e293b;\n}\n\n.article-html-content strong,\n.article-html-content b {\n  font-weight: 700;\n  color: #0f172a;\n}\n\n.article-html-content em,\n.article-html-content i {\n  font-style: italic;\n  color: #334155;\n}\n\n.article-html-content h1,\n.article-html-content h2,\n.article-html-content h3,\n.article-html-content h4 {\n  font-weight: 800;\n  color: #0f172a;\n  margin-top: 1.5rem;\n  margin-bottom: 0.75rem;\n  line-height: 1.3;\n}\n\n.article-html-content h2 {\n  font-size: 1.35rem;\n}\n\n.article-html-content h3 {\n  font-size: 1.2rem;\n}\n\n.article-html-content blockquote {\n  border-left: 4px solid #dc2626;\n  background-color: #f8fafc;\n  padding: 0.75rem 1rem;\n  margin: 1.25rem 0;\n  border-radius: 0 0.5rem 0.5rem 0;\n  font-style: italic;\n  color: #334155;\n}\n\n.article-html-content ul {\n  list-style-type: disc;\n  padding-left: 1.5rem;\n  margin: 1rem 0;\n  color: #334155;\n}\n\n.article-html-content ol {\n  list-style-type: decimal;\n  padding-left: 1.5rem;\n  margin: 1rem 0;\n  color: #334155;\n}\n\n.article-html-content li {\n  margin-bottom: 0.35rem;\n}\n\n.article-html-content a {\n  color: #dc2626;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  font-weight: 600;\n}\n\n.article-html-content a:hover {\n  color: #b91c1c;\n}\n\n.article-html-content img {\n  border-radius: 0.75rem;\n  max-width: 100%;\n  height: auto;\n  margin: 1.25rem auto;\n  box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);\n}\n\n/* -------------------------------------------------------------\n   DARK MODE / NIGHT READING THEME ENHANCEMENTS\n   ------------------------------------------------------------- */\nhtml.dark {\n  color-scheme: dark;\n}\n\nhtml.dark body {\n  background-color: #080c14 !important;\n  color: #f1f5f9 !important;\n}\n\nhtml.dark #public-portal-root {\n  background-color: #080c14 !important;\n  color: #f1f5f9 !important;\n}\n\nhtml.dark header.bg-white,\nhtml.dark nav.bg-white,\nhtml.dark div.bg-white {\n  background-color: #0f172a !important;\n  color: #f8fafc !important;\n  border-color: #1e293b !important;\n}\n\nhtml.dark div.bg-slate-50,\nhtml.dark div.bg-slate-100 {\n  background-color: #151e32 !important;\n  border-color: #1e293b !important;\n}\n\nhtml.dark .border-slate-200,\nhtml.dark .border-slate-100 {\n  border-color: #1e293b !important;\n}\n\nhtml.dark .text-slate-900,\nhtml.dark h1,\nhtml.dark h2,\nhtml.dark h3,\nhtml.dark h4,\nhtml.dark h5 {\n  color: #f8fafc !important;\n}\n\nhtml.dark .text-slate-800,\nhtml.dark .text-slate-700 {\n  color: #cbd5e1 !important;\n}\n\nhtml.dark .text-slate-600,\nhtml.dark .text-slate-500 {\n  color: #94a3b8 !important;\n}\n\nhtml.dark .text-slate-400 {\n  color: #64748b !important;\n}\n\nhtml.dark .article-html-content p {\n  color: #cbd5e1 !important;\n}\n\nhtml.dark .article-html-content strong,\nhtml.dark .article-html-content b {\n  color: #ffffff !important;\n}\n\nhtml.dark .article-html-content em,\nhtml.dark .article-html-content i {\n  color: #94a3b8 !important;\n}\n\nhtml.dark .article-html-content blockquote {\n  background-color: #151e32 !important;\n  color: #94a3b8 !important;\n  border-left-color: #ef4444 !important;\n}\n\nhtml.dark .article-html-content ul,\nhtml.dark .article-html-content ol,\nhtml.dark .article-html-content li {\n  color: #cbd5e1 !important;\n}\n\n/* -------------------------------------------------------------\n   PRINT & SINGLE-PAGE A4 PDF OPTIMIZATION FOR E-PAPER\n   ------------------------------------------------------------- */\n@media print {\n  @page {\n    size: A4 portrait;\n    margin: 4mm 4mm 4mm 4mm;\n  }\n... (truncated)\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
