rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Reusable RBAC & Auth Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().status == 'ACTIVE');
    }

    function isSuperAdmin() {
      return isUserActive() && (getUserData().role == 'SUPER_ADMIN');
    }

    function isAdmin() {
      return isUserActive() && (getUserData().role == 'SUPER_ADMIN' || getUserData().role == 'ADMIN');
    }

    function isEditor() {
      return isUserActive() && (isAdmin() || getUserData().role == 'EDITOR');
    }

    function isStaff() {
      return isUserActive() && (
        isEditor() ||
        getUserData().role == 'SUB_EDITOR' ||
        getUserData().role == 'REPORTER' ||
        getUserData().role == 'VIDEO_REPORTER' ||
        getUserData().role == 'PHOTOGRAPHER'
      );
    }

    // -------------------------------------------------------------
    // 1. POSTS (News Articles & Content)
    // -------------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isEditor() || (isStaff() && resource.data.authorId == request.auth.uid && resource.data.status != 'PUBLISHED');
      allow delete: if isAdmin() || (isStaff() && resource.data.authorId == request.auth.uid && resource.data.status == 'DRAFT');
    }

    // -------------------------------------------------------------
    // 2. STATIC PAGES (About Us, Privacy Policy, Terms, etc.)
    // -------------------------------------------------------------
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 3. MEDIA LIBRARY (Images, Videos, Audio, Documents)
    // -------------------------------------------------------------
    match /media/{mediaId} {
      allow read: if true;
      allow create: if isStaff();
      allow update, delete: if isAdmin() || (isStaff() && resource.data.uploadedBy == request.auth.uid);
    }

    // -------------------------------------------------------------
    // 4. TAXONOMY & SITE STRUCTURE (Categories, Tags, Menus)
    // -------------------------------------------------------------
    match /categories/{catId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. SOCIAL MEDIA, REELS & TICKERS
    // -------------------------------------------------------------
    match /social_posts/{socId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /tickers/{tickerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // -------------------------------------------------------------
    // 6. ADVERTISEMENTS & ADSENSE
    // -------------------------------------------------------------
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. CITIZEN NEWS REPORTS & MERCHANT ADS (Public Submissions)
    // -------------------------------------------------------------
    match /citizen_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }
    match /merchant_ads/{adId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 8. COMMENTS & POLLS (Reader Interactions)
    // -------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isEditor();
    }
    match /polls/{pollId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if isEditor();
    }

    // -------------------------------------------------------------
    // 9. GLOBAL SETTINGS (SEO, Theme, AdSense, E-Paper)
    // -------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 9A. E-PAPER EDITIONS & DISTRICTS
    // epaper_editions: id, districtCode, districtName, publicationDate,
    // title, status, pdfUrl, storagePath, fileName, fileSizeBytes, mimeType,
    // createdBy, createdAt, updatedAt, optional publishedAt/totalPages.
    // epaper_districts: code, name, isActive, displayOrder.
    // -------------------------------------------------------------
    function isValidEPaperEdition(data) {
      return data.keys().hasAll([
          'id', 'districtCode', 'districtName', 'publicationDate', 'title', 'status',
          'pdfUrl', 'storagePath', 'fileName', 'fileSizeBytes', 'mimeType',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'districtCode', 'districtName', 'publicationDate', 'title', 'status',
          'pdfUrl', 'storagePath', 'fileName', 'fileSizeBytes', 'mimeType',
          'createdBy', 'createdAt', 'updatedAt', 'publishedAt', 'totalPages'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.districtCode is string && data.districtCode.size() > 0 && data.districtCode.size() <= 50
        && data.districtName is string && data.districtName.size() > 0 && data.districtName.size() <= 100
        && data.publicationDate is string && data.publicationDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.status in ['DRAFT', 'PUBLISHED']
        && data.pdfUrl is string && data.pdfUrl.matches('^https://.*') && data.pdfUrl.size() <= 2000
        && data.storagePath is string && data.storagePath.size() > 0 && data.storagePath.size() <= 500
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
        && data.fileSizeBytes is int && data.fileSizeBytes > 0 && data.fileSizeBytes <= 26214400
        && data.mimeType == 'application/pdf'
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('publishedAt' in data) || data.publishedAt == null || data.publishedAt is timestamp)
        && (!('totalPages' in data) || (data.totalPages is int && data.totalPages > 0 && data.totalPages <= 200));
    }

    function isValidEPaperDistrict(data) {
      return data.keys().hasAll(['code', 'name', 'isActive', 'displayOrder'])
        && data.keys().hasOnly(['code', 'name', 'isActive', 'displayOrder'])
        && data.code is string && data.code.size() > 0 && data.code.size() <= 50
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.isActive is bool
        && data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 1000;
    }

    match /epaper_editions/{editionId} {
      allow get: if resource.data.status == 'PUBLISHED' || isAdmin();
      allow list: if isAdmin() || resource.data.status == 'PUBLISHED';
      allow create: if isAdmin()
        && request.resource.data.id == editionId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'DRAFT'
        && isValidEPaperEdition(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidEPaperEdition(request.resource.data);
      allow delete: if isAdmin();
    }

    match /epaper_districts/{districtCode} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.code == districtCode
        && isValidEPaperDistrict(request.resource.data);
      allow delete: if isAdmin();
    }

    // Billing threat model: authenticated admins are the only readers/writers;
    // document IDs, numbering and creation time are immutable; deletes are archival.
    function shortString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }
    function optionalString(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }
    function validArchiveFields(data) {
      return (!('isArchived' in data) || data.isArchived is bool)
        && (!('archivedAt' in data) || data.archivedAt is timestamp);
    }
    function validMoney(value) {
      return value is number && value >= 0 && value <= 100000000;
    }
    function validBillingBase(data) {
      return shortString(data.id, 128)
        && shortString(data.createdAt, 40)
        && shortString(data.updatedAt, 40)
        && validArchiveFields(data);
    }
    function validInvoice(data) {
      return data.keys().hasAll(['id','invoiceNumber','billDate','dueDate','clientName','clientPhone','category','categoryLabelMarathi','items','subtotal','discountAmount','gstAmount','totalAmount','amountPaid','balanceDue','status','createdAt','updatedAt'])
        && data.keys().hasOnly(['id','invoiceNumber','billDate','dueDate','clientName','businessName','clientPhone','clientEmail','clientAddress','clientGstin','category','categoryLabelMarathi','items','subtotal','discountAmount','gstAmount','totalAmount','amountPaid','balanceDue','status','paymentMethod','transactionRef','notes','terms','createdAt','updatedAt','isArchived','archivedAt'])
        && validBillingBase(data) && shortString(data.invoiceNumber, 80)
        && shortString(data.billDate, 10) && shortString(data.dueDate, 10)
        && shortString(data.clientName, 200) && shortString(data.clientPhone, 30)
        && optionalString(data, 'businessName', 200) && optionalString(data, 'clientEmail', 254)
        && optionalString(data, 'clientAddress', 1000) && optionalString(data, 'clientGstin', 30)
        && optionalString(data, 'transactionRef', 120) && optionalString(data, 'notes', 3000)
        && optionalString(data, 'terms', 5000)
        && data.category in ['PORTAL_BANNER','EPAPER_CLASSIFIED','FESTIVAL_WISH','SPONSORED_NEWS','EPAPER_SUBSCRIPTION','PRINT_COMMERCIAL','OTHER']
        && data.status in ['PAID','PENDING','PARTIAL','OVERDUE','CANCELLED']
        && (!('paymentMethod' in data) || data.paymentMethod in ['UPI','CASH','NET_BANKING','CHEQUE','CREDIT_CARD','NEFT_RTGS'])
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && validMoney(data.subtotal) && validMoney(data.discountAmount) && data.discountAmount <= data.subtotal
        && validMoney(data.gstAmount) && validMoney(data.totalAmount)
        && validMoney(data.amountPaid) && data.amountPaid <= data.totalAmount
        && validMoney(data.balanceDue) && data.balanceDue == data.totalAmount - data.amountPaid;
    }
    function validQuotation(data) {
      return data.keys().hasAll(['id','quotationNumber','date','validUntil','clientName','clientPhone','category','categoryLabelMarathi','items','subtotal','discountAmount','gstAmount','totalAmount','status','createdAt','updatedAt'])
        && data.keys().hasOnly(['id','quotationNumber','date','validUntil','clientName','businessName','clientPhone','clientEmail','clientAddress','clientGstin','category','categoryLabelMarathi','items','subtotal','discountAmount','gstAmount','totalAmount','status','convertedInvoiceId','notes','terms','createdAt','updatedAt','isArchived','archivedAt'])
        && validBillingBase(data) && shortString(data.quotationNumber, 80)
        && shortString(data.date, 10) && shortString(data.validUntil, 10)
        && shortString(data.clientName, 200) && shortString(data.clientPhone, 30)
        && optionalString(data, 'businessName', 200) && optionalString(data, 'clientEmail', 254)
        && optionalString(data, 'clientAddress', 1000) && optionalString(data, 'clientGstin', 30)
        && optionalString(data, 'convertedInvoiceId', 128) && optionalString(data, 'notes', 3000)
        && optionalString(data, 'terms', 5000)
        && data.category in ['PORTAL_BANNER','EPAPER_CLASSIFIED','FESTIVAL_WISH','SPONSORED_NEWS','EPAPER_SUBSCRIPTION','PRINT_COMMERCIAL','OTHER']
        && data.status in ['DRAFT','SENT','ACCEPTED','REJECTED','CONVERTED']
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && validMoney(data.subtotal) && validMoney(data.discountAmount) && data.discountAmount <= data.subtotal
        && validMoney(data.gstAmount) && validMoney(data.totalAmount);
    }
    function validClient(data) {
      return data.keys().hasAll(['id','name','phone','createdAt','updatedAt'])
        && data.keys().hasOnly(['id','name','businessName','phone','email','address','gstin','category','notes','createdAt','updatedAt','isArchived','archivedAt'])
        && validBillingBase(data) && shortString(data.name, 200) && shortString(data.phone, 30)
        && optionalString(data, 'businessName', 200) && optionalString(data, 'email', 254)
        && optionalString(data, 'address', 1000) && optionalString(data, 'gstin', 30)
        && optionalString(data, 'notes', 3000)
        && (!('category' in data) || data.category in ['PORTAL_BANNER','EPAPER_CLASSIFIED','FESTIVAL_WISH','SPONSORED_NEWS','EPAPER_SUBSCRIPTION','PRINT_COMMERCIAL','OTHER']);
    }

    match /billing_invoices/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.id == recordId && validInvoice(request.resource.data);
      allow update: if isAdmin() && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && validInvoice(request.resource.data);
      allow delete: if false;
    }
    match /billing_clients/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.id == recordId && validClient(request.resource.data);
      allow update: if isAdmin() && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt && validClient(request.resource.data);
      allow delete: if false;
    }
    match /billing_quotations/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.id == recordId && validQuotation(request.resource.data);
      allow update: if isAdmin() && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.quotationNumber == resource.data.quotationNumber
        && validQuotation(request.resource.data);
      allow delete: if false;
    }
    match /billing_settings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && settingId == 'main'
        && request.resource.data.keys().hasAll(['publicationName','publicationTagline','businessAddress','phone','email','website','gstin','rniNumber','state','stateCode','hsnSacCode','showGstin','showBankQr','bankAccountName','bankName','bankAccountNumber','bankIfsc','bankBranch','bankAccountType','upiId','upiPayeeName','invoicePrefix','quotationPrefix','defaultDueDays','defaultQuotationValidityDays','defaultInvoiceNotes','defaultInvoiceTerms','defaultQuotationNotes','defaultQuotationTerms','signatoryTitle'])
        && request.resource.data.keys().hasOnly(['publicationName','publicationTagline','businessAddress','phone','email','website','gstin','rniNumber','state','stateCode','hsnSacCode','showGstin','showBankQr','bankAccountName','bankName','bankAccountNumber','bankIfsc','bankBranch','bankAccountType','upiId','upiPayeeName','upiMerchantCode','invoicePrefix','quotationPrefix','defaultDueDays','defaultQuotationValidityDays','defaultInvoiceNotes','defaultInvoiceTerms','defaultQuotationNotes','defaultQuotationTerms','signatoryTitle'])
        && request.resource.data.showGstin is bool && request.resource.data.showBankQr is bool
        && request.resource.data.defaultDueDays is int && request.resource.data.defaultDueDays >= 0 && request.resource.data.defaultDueDays <= 365
        && request.resource.data.defaultQuotationValidityDays is int && request.resource.data.defaultQuotationValidityDays >= 0 && request.resource.data.defaultQuotationValidityDays <= 365;
      allow delete: if false;
    }
    match /billing_counters/{counterId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['id','kind','financialYear','lastNumber','updatedAt'])
        && request.resource.data.id == counterId && request.resource.data.kind in ['invoice','quotation']
        && shortString(request.resource.data.financialYear, 16) && request.resource.data.lastNumber == 1
        && shortString(request.resource.data.updatedAt, 40);
      allow update: if isAdmin() && request.resource.data.keys().hasOnly(['id','kind','financialYear','lastNumber','updatedAt'])
        && request.resource.data.id == resource.data.id && request.resource.data.kind == resource.data.kind
        && request.resource.data.financialYear == resource.data.financialYear
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && shortString(request.resource.data.updatedAt, 40);
      allow delete: if false;
    }
    match /billing_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['id','action','entityType','entityId','actorUid','createdAt','details'])
        && request.resource.data.keys().hasOnly(['id','action','entityType','entityId','actorUid','createdAt','details'])
        && request.resource.data.id == auditId && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['UPSERT','ARCHIVE','UPDATE_SETTINGS']
        && request.resource.data.entityType in ['invoice','quotation','client','settings']
        && shortString(request.resource.data.entityId, 128)
        && request.resource.data.createdAt == request.time
        && request.resource.data.details is map && request.resource.data.details.keys().size() <= 10;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // 10. USER PROFILES & RBAC DIRECTORY (Anti-Privilege Escalation)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in request.resource.data) || request.resource.data.role in ['USER', 'REPORTER']
      );
      allow update: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('customPermissions' in request.resource.data) || request.resource.data.customPermissions == resource.data.customPermissions)
      );
      allow delete: if isSuperAdmin();
    }
  }
}
