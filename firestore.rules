rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Reusable RBAC & Auth Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().status == 'ACTIVE');
    }

    function isSuperAdmin() {
      return isUserActive() && (getUserData().role == 'SUPER_ADMIN');
    }

    function isAdmin() {
      return isUserActive() && (getUserData().role == 'SUPER_ADMIN' || getUserData().role == 'ADMIN');
    }

    function isEditor() {
      return isUserActive() && (isAdmin() || getUserData().role == 'EDITOR');
    }

    function isStaff() {
      return isUserActive() && (
        isEditor() ||
        getUserData().role == 'SUB_EDITOR' ||
        getUserData().role == 'REPORTER' ||
        getUserData().role == 'VIDEO_REPORTER' ||
        getUserData().role == 'PHOTOGRAPHER'
      );
    }

    // -------------------------------------------------------------
    // 1. POSTS (News Articles & Content)
    // -------------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isEditor() || (isStaff() && resource.data.authorId == request.auth.uid && resource.data.status != 'PUBLISHED');
      allow delete: if isAdmin() || (isStaff() && resource.data.authorId == request.auth.uid && resource.data.status == 'DRAFT');
    }

    // -------------------------------------------------------------
    // 2. STATIC PAGES (About Us, Privacy Policy, Terms, etc.)
    // -------------------------------------------------------------
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 3. MEDIA LIBRARY (Images, Videos, Audio, Documents)
    // -------------------------------------------------------------
    match /media/{mediaId} {
      allow read: if true;
      allow create: if isStaff();
      allow update, delete: if isAdmin() || (isStaff() && resource.data.uploadedBy == request.auth.uid);
    }

    // -------------------------------------------------------------
    // 4. TAXONOMY & SITE STRUCTURE (Categories, Tags, Menus)
    // -------------------------------------------------------------
    match /categories/{catId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. SOCIAL MEDIA, REELS & TICKERS
    // -------------------------------------------------------------
    match /social_posts/{socId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /tickers/{tickerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // -------------------------------------------------------------
    // 6. ADVERTISEMENTS & ADSENSE
    // -------------------------------------------------------------
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. CITIZEN NEWS REPORTS & MERCHANT ADS (Public Submissions)
    // -------------------------------------------------------------
    match /citizen_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }
    match /merchant_ads/{adId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 8. COMMENTS & POLLS (Reader Interactions)
    // -------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isEditor();
    }
    match /polls/{pollId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if isEditor();
    }

    // -------------------------------------------------------------
    // 9. GLOBAL SETTINGS (SEO, Theme, AdSense, E-Paper)
    // -------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 10. USER PROFILES & RBAC DIRECTORY (Anti-Privilege Escalation)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in request.resource.data) || request.resource.data.role in ['USER', 'REPORTER']
      );
      allow update: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('customPermissions' in request.resource.data) || request.resource.data.customPermissions == resource.data.customPermissions)
      );
      allow delete: if isSuperAdmin();
    }
  }
}
